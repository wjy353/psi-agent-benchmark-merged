# TB Benchmark 服务器端环境变量
# 复制本文件为 .env 并填入真实值
# 此文件部署到服务器上，被 run_all_cases.py 读取

# 远程评测服务器（支持密码或密钥二选一）
TB_BENCH_HOST=your.server.ip
TB_BENCH_USER=root
TB_BENCH_PASSWORD=
TB_BENCH_KEY=

# 大模型 API（服务器上的 psi-agent 使用）
PSI_AI_MODEL=deepseek-chat
PSI_AI_PROVIDER=openai
PSI_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PSI_AI_BASE_URL=https://api.deepseek.com/v1

# 工具路径（留空使用默认值）
TB_HARBOR_BIN=harbor
TB_UV_BIN=uv

# psi-agent 仓库和版本
PSI_AGENT_REPO=https://github.com/genuineknowledge/psi-agent.git
PSI_AGENT_REF=main

# 服务器工作目录
TB_BENCH_WORKDIR=$HOME/psi-agent-benchmark
