# ── Model configuration ──────────────────────────────────────────────────
PSI_AI_PROVIDER=openai
PSI_AI_MODEL=glm-5.3-max
PSI_AI_API_KEY=your-zhipu-api-key-here
PSI_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── psi-agent source (harbor clones this inside each task container) ─────
PSI_AGENT_REPO=https://github.com/genuineknowledge/psi-agent.git
PSI_AGENT_REF=main
PSI_AGENT_WORKSPACE=workspaces/terminal_bench

# ── Harbor configuration ──────────────────────────────────────────────────
TB_HARBOR_BIN=harbor
TB_BENCH_WORKDIR=

# ── tau2/GAIA (local execution) ──────────────────────────────────────────
TAU2_BENCH_DIR=external/tau2-bench
GAIA_DATA_DIR=external/gaia-data
