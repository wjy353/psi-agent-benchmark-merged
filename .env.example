# 远程 TB 评测服务器配置（TB 2.1/3.0 需要）
# 复制为 .env 并填入真实值
# API Key 放在服务器侧的 psi-agent/.env，不在此文件

# 服务器地址（支持密码或私钥二选一）
TB_BENCH_HOST=your.server.ip
TB_BENCH_USER=root
TB_BENCH_PASSWORD=
TB_BENCH_KEY=~/.ssh/id_ed25519

# 服务器工作目录
TB_BENCH_WORKDIR=/root/psi-agent-benchmark

# 工具路径（留空使用默认值）
TB_HARBOR_BIN=harbor
TB_UV_BIN=uv

# psi-agent 仓库和版本
PSI_AGENT_REPO=https://github.com/genuineknowledge/psi-agent.git
PSI_AGENT_REF=main
